<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_bg"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context="com.paymentsave.paymentsave.coreapp.activities.cashback.CashbackActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:gravity="center_vertical">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/cashback_back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/disable_btn_color"
            android:src="@drawable/ic_arrow_back_24"
            app:backgroundTint="@color/purple_200"
            app:elevation="0dp"
            app:fabCustomSize="30dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/cashback"
            android:textColor="@color/text_color"
            android:textSize="@dimen/text_size_large"
            android:textStyle="bold" />


    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/main_amt_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/_0_00"
            android:textColor="@color/text_color"
            android:textSize="@dimen/text_size_super_large" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="30dp"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:text="What cashback amount would you like to add?"
            android:textColor="@color/text_color"
            android:textSize="@dimen/text_size_xx_large" />

        <Button
            android:id="@+id/no_thanks_cashback_btn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:background="@drawable/radius_gray_btn"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/no_thanks"
            android:textColor="@color/gray_light_color" />

        <ListView
            android:id="@+id/cashback_lv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@android:color/transparent" />

        <Button
            android:id="@+id/exec_ten_btn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:background="@drawable/radius_gray_btn"
            android:fontFamily="@font/poppins_medium"
            android:text="£10"
            android:textColor="@color/text_color"
            android:visibility="gone"/>

        <Button
            android:id="@+id/exec_fifteen_btn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:background="@drawable/radius_gray_btn"
            android:fontFamily="@font/poppins_medium"
            android:text="£15"
            android:textColor="@color/text_color"
            android:visibility="gone" />

        <Button
            android:id="@+id/exec_twenty_btn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:background="@drawable/radius_gray_btn"
            android:fontFamily="@font/poppins_medium"
            android:text="£20"
            android:textColor="@color/text_color"
            android:visibility="gone" />

        <Button
            android:id="@+id/exec_thirty_btn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:background="@drawable/radius_gray_btn"
            android:fontFamily="@font/poppins_medium"
            android:text="£30"
            android:textColor="@color/text_color"
            android:visibility="gone" />

        <Button
            android:id="@+id/cashback_custom_btn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="8dp"
            android:background="@drawable/radius_gray_btn"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/custom_amount"
            android:textColor="@color/text_color" />
    </LinearLayout>


</LinearLayout>