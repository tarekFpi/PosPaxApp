<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teal_200"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context="com.paymentsave.paymentsave.coreapp.activities.CounterPay.CounterPayActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/connection_stat_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="22dp"
            android:background="@drawable/gray_light_radius"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/connection_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/connecting"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_small" />

            <ProgressBar
                android:id="@+id/connection_progress_bar"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:indeterminateTint="@color/white"/>

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/cp_options_btn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:visibility="gone"
            android:background="?android:attr/actionBarItemBackground"
            android:src="@drawable/baseline_menu_dot_icon_24" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/animation_view"
            android:layout_centerInParent="true"
            android:layout_marginBottom="30dp"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/counter_payment"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_XL_large" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/animation_view"
            android:layout_centerInParent="true"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/poppins_medium"
            android:paddingTop="2dp"
            android:text="@string/waiting_for_payment"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_medium" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/animation_view"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_centerInParent="true"
            android:paddingTop="20dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/interlink2" />

        <ImageView
            android:id="@+id/business_logo"
            android:layout_width="150dp"
            android:layout_height="100dp"
            android:src="@drawable/paymentsave_logo"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"/>

    </RelativeLayout>

</LinearLayout>