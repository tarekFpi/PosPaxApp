<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_bg"
    android:paddingBottom="70dp"
    tools:context="com.paymentsave.paymentsave.coreapp.fragments.onboard.OnboardHomeFragment">

    <RelativeLayout
        android:id="@+id/marquee_layout"
        android:layout_width="fill_parent"
        android:layout_height="30dp"
        android:layout_marginTop="24dp"
        android:background="@color/green_text_color"
        android:gravity="center">

        <TextView
            android:id="@+id/alert_wrap_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:ellipsize="marquee"
            android:fadingEdge="horizontal"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/white" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="30dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/home_logo_iv"
            android:layout_width="wrap_content"
            android:layout_height="65dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:paddingStart="70dp"
            android:paddingEnd="70dp"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/tv_enter_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|center_vertical"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/enter_amount"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <EditText
            android:id="@+id/ed_enter_rrn_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center_horizontal"
            android:layout_margin="10dp"
            android:autofillHints=""
            android:ems="10"
            android:gravity="end"
            android:hint="@string/hint_rrn"
            android:inputType="number"
            android:maxLength="12"
            android:visibility="gone" />

        <EditText
            android:id="@+id/ed_enter_cancel_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center_horizontal"
            android:layout_margin="10dp"
            android:autofillHints=""
            android:ems="10"
            android:gravity="end"
            android:hint="@string/hint_cancel_time"
            android:inputType="number"
            android:maxLength="12"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <!--            android:gravity="right|center"-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="1pt"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/ed_enter_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""

                    android:ems="10"
                    android:focusable="false"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:text="@string/_0_00"
                    android:textColor="@android:color/black"
                    android:textSize="22pt" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/note_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_note"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/note_et"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:cursorVisible="true"
                        android:focusable="true"
                        android:maxLength="18"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:imeOptions="actionDone"
                        android:inputType="text|textCapSentences"
                        android:maxLines="1"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/btnClose"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="end"
                        android:visibility="gone"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/radius_gray"
                        android:src="@drawable/baseline_close_24"
                        android:scaleType="centerInside"
                        android:padding="8dp"
                        android:contentDescription="Close" />
                </LinearLayout>

                <TextView
                    android:id="@+id/invalid_amount_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/please_enter_a_valid_amount"
                    android:textColor="@color/red"
                    android:visibility="gone" />

            </LinearLayout>


            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="1pt"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnOne"
                        style="@style/input_btn"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:text="@string/one"
                        app:backgroundTint="@null"
                        app:backgroundTintMode="add" />

                    <Button
                        android:id="@+id/btnTwo"
                        style="@style/input_btn"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:text="@string/two"
                        app:backgroundTint="@null"
                        app:backgroundTintMode="add" />

                    <Button
                        android:id="@+id/btnThree"
                        style="@style/input_btn"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:text="@string/three"
                        app:backgroundTint="@null"
                        app:backgroundTintMode="add" />

                </TableRow>

            </TableLayout>

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="1pt"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnFour"
                        style="@style/input_btn"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:text="@string/_4"
                        app:backgroundTint="@null"
                        app:backgroundTintMode="add" />

                    <Button
                        android:id="@+id/btnFive"
                        style="@style/input_btn"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:text="@string/_5"
                        app:backgroundTint="@null"
                        app:backgroundTintMode="add" />

                    <Button
                        android:id="@+id/btnSix"
                        style="@style/input_btn"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:text="@string/_6"
                        app:backgroundTint="@null"
                        app:backgroundTintMode="add" />

                </TableRow>

            </TableLayout>

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="1pt"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnSeven"
                        style="@style/input_btn"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:text="@string/_7"
                        app:backgroundTint="@null"
                        app:backgroundTintMode="add" />

                    <Button
                        android:id="@+id/btnEight"
                        style="@style/input_btn"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:text="@string/_8"
                        app:backgroundTint="@null"
                        app:backgroundTintMode="add" />

                    <Button
                        android:id="@+id/btnNine"
                        style="@style/input_btn"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:text="@string/_9"
                        app:backgroundTint="@null"
                        app:backgroundTintMode="add" />

                </TableRow>

            </TableLayout>

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="1pt"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnDoubleZero"
                        style="@style/input_btn"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:text="@string/dubleZero"
                        app:backgroundTint="@null"
                        app:backgroundTintMode="add" />


                    <Button
                        android:id="@+id/btnZero"
                        style="@style/input_btn"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:text="@string/zero"
                        app:backgroundTint="@null"
                        app:backgroundTintMode="add" />


                    <ImageButton
                        android:id="@+id/btnC"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@drawable/ic_baseline_backspace_24"
                        android:textSize="22sp"
                        tools:ignore="SpeakableTextPresentCheck" />


                </TableRow>

            </TableLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="10dp">

                <!--                <LinearLayout-->
                <!--                    android:id="@+id/button_submit"-->
                <!--                    android:layout_width="match_parent"-->
                <!--                    android:layout_height="50dp"-->
                <!--                    android:layout_margin="10dp"-->
                <!--                    android:clickable="true"-->
                <!--                    android:focusable="true"-->
                <!--                    android:gravity="center"-->
                <!--                    android:orientation="horizontal">-->

                <!--                    <LinearLayout-->
                <!--                        android:layout_width="match_parent"-->
                <!--                        android:layout_height="match_parent"-->
                <!--                        android:background="@drawable/radius_btn_bg"-->
                <!--                        android:gravity="center"-->
                <!--                        android:orientation="horizontal">-->

                <!--                        <ImageView-->
                <!--                            android:layout_width="wrap_content"-->
                <!--                            android:layout_height="wrap_content"-->
                <!--                            android:padding="10dp"-->
                <!--                            android:src="@drawable/ic_baseline_credit_card_24" />-->

                <!--                        <TextView-->
                <!--                            android:layout_width="wrap_content"-->
                <!--                            android:layout_height="wrap_content"-->
                <!--                            android:text="Pay with card"-->
                <!--                            android:textColor="@android:color/white"-->
                <!--                            android:textSize="18sp" />-->
                <!--                    </LinearLayout>-->


                <!--                </LinearLayout>-->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/split_bill_btn"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/radius_gray"
                        android:minHeight="50dp"
                        android:text="@string/split_bill"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_large"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/button_submit"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/radius_gray"
                        android:minHeight="50dp"
                        android:text="@string/pay_now"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_large" />
                </LinearLayout>


                <!--                <Button-->
                <!--                    android:layout_width="match_parent"-->
                <!--                    android:layout_height="50dp"-->
                <!--                    android:layout_margin="10dp"-->
                <!--                    android:background="@drawable/radius_gray_btn"-->
                <!--                    android:text="Pay with cash"-->
                <!--                    android:textAllCaps="false"-->
                <!--                    android:textColor="@android:color/black"-->
                <!--                    android:textSize="18sp" />-->

            </LinearLayout>

            <!--            <TableLayout-->
            <!--                android:layout_width="match_parent"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:background="#F4F4F4">-->

            <!--                <TableRow-->
            <!--                    android:layout_width="match_parent"-->
            <!--                    android:layout_marginBottom="1pt"-->
            <!--                    android:layout_height="match_parent">-->


            <!--                    <Button-->
            <!--                        android:id="@+id/button_submit"-->
            <!--                        android:text="@string/pay_now"-->
            <!--                        android:layout_marginEnd="1pt"-->
