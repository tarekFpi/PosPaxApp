<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_bg"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context="com.paymentsave.paymentsave.coreapp.activities.setSupervisorPIN.SetSupervisorPinActivity">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/keypad_supervisor_pin_layout"
            android:layout_alignParentTop="true"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="95dp"
                android:paddingStart="80dp"
                android:paddingEnd="80dp"
                android:src="@drawable/ic_ptsave" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/set_your_supervisor_pin"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/you_ll_use_this_pin_to_access_this_service"
                android:textColor="#80444444"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/pinInput1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/radius_white"
                    android:focusable="false"
                    android:gravity="center"
                    android:inputType="numberPassword"
                    android:maxLength="1"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/pinInput2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/radius_white"
                    android:focusable="false"
                    android:gravity="center"
                    android:inputType="numberPassword"
                    android:maxLength="1"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/pinInput3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/radius_white"
                    android:focusable="false"
                    android:gravity="center"
                    android:inputType="numberPassword"
                    android:maxLength="1"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/pinInput4"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/radius_white"
                    android:focusable="false"
                    android:gravity="center"
                    android:inputType="numberPassword"
                    android:maxLength="1"
                    android:textSize="24sp" />

                <ImageButton
                    android:id="@+id/pinVisibilityBtn"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@android:color/transparent"
                    android:padding="10dp"
                    android:src="@drawable/ic_baseline_visibility_off_24" />

            </LinearLayout>

            <TextView
                android:id="@+id/invalid_input_alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:paddingStart="0dp"
                android:paddingEnd="20dp"
                android:visibility="gone"
                android:text="@string/please_enter_a_valid_pin"
                android:textColor="@color/red"
                android:textSize="16sp"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/keypad_supervisor_pin_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/setup_your_new_device_btn"
            android:layout_marginBottom="0dp"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn01"
                    style="@style/input_btn"
                    app:backgroundTint="@null"
                    app:backgroundTintMode="add"
                    android:layout_width="80dp"
                    android:layout_height="70dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/button_ripple"
                    android:text="@string/one"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn02"
                    style="@style/input_btn"
                    app:backgroundTint="@null"
                    app:backgroundTintMode="add"
                    android:layout_width="80dp"
                    android:layout_height="70dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/button_ripple"
                    android:text="@string/two"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn03"
                    style="@style/input_btn"
                    app:backgroundTint="@null"
                    app:backgroundTintMode="add"
                    android:layout_width="80dp"
                    android:layout_height="70dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/button_ripple"
                    android:text="@string/three"
                    android:textSize="22sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn04"
                    style="@style/input_btn"
                    app:backgroundTint="@null"
                    app:backgroundTintMode="add"
                    android:layout_width="80dp"
                    android:layout_height="70dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/button_ripple"
                    android:text="@string/_4"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn05"
                    style="@style/input_btn"
                    app:backgroundTint="@null"
                    app:backgroundTintMode="add"
                    android:layout_width="80dp"
                    android:layout_height="70dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/button_ripple"
                    android:text="@string/_5"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn06"
                    style="@style/input_btn"
                    app:backgroundTint="@null"
                    app:backgroundTintMode="add"
                    android:layout_width="80dp"
                    android:layout_height="70dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/button_ripple"
                    android:text="@string/_6"
                    android:textSize="22sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn07"
                    style="@style/input_btn"
                    app:backgroundTint="@null"
                    app:backgroundTintMode="add"
                    android:layout_width="80dp"
                    android:layout_height="70dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/button_ripple"
                    android:text="@string/_7"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn08"
                    style="@style/input_btn"
                    app:backgroundTint="@null"
                    app:backgroundTintMode="add"
                    android:layout_width="80dp"
                    android:layout_height="70dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/button_ripple"
                    android:text="@string/_8"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn09"
                    style="@style/input_btn"
                    app:backgroundTint="@null"
                    app:backgroundTintMode="add"
                    android:layout_width="80dp"
                    android:layout_height="70dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/button_ripple"
                    android:text="@string/_9"
                    android:textSize="22sp" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:layout_width="80dp"
                    android:layout_height="70dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/radius_white"
                    android:text=""
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btn00"
                    style="@style/input_btn"
                    app:backgroundTint="@null"
                    app:backgroundTintMode="add"
                    android:layout_width="80dp"
                    android:layout_height="70dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/button_ripple"
                    android:text="@string/zero"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/btnBackSpace"
                    style="@style/input_btn"
                    app:backgroundTint="@null"
                    app:backgroundTintMode="add"
                    android:layout_width="80dp"
                    android:layout_height="70dp"
                    android:layout_margin="2dp"
                    android:background="@drawable/button_ripple"
                    android:text="@string/back_space_btn"
                    android:textSize="22sp" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/setup_your_new_device_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/stepper03"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/radius_gray"
            android:minHeight="48dp"
            android:text="@string/confirm_supervisor_pin"
            android:textAllCaps="false"
            android:textColor="@color/white" />

        <LinearLayout
            android:id="@+id/stepper03"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="35dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="2dp"
                android:background="@drawable/white_circle" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="2dp"
                android:background="@drawable/white_circle" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="2dp"
                android:background="@drawable/blue_circle" />


            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="2dp"
                android:background="@drawable/white_circle" />


        </LinearLayout>

    </RelativeLayout>

</LinearLayout>