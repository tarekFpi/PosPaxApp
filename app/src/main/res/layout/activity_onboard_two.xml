<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_bg"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context="com.paymentsave.paymentsave.coreapp.activities.onboard.OnboardTwoActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/smp_2"
            android:layout_alignParentTop="true"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="90dp"
                android:paddingStart="80dp"
                android:paddingEnd="80dp"
                android:src="@drawable/ic_ptsave" />

<!--            <ImageView-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="match_parent"-->
<!--                android:paddingStart="10dp"-->
<!--                android:paddingTop="0dp"-->
<!--                android:paddingEnd="10dp"-->
<!--                android:paddingBottom="30dp"-->
<!--                android:src="@drawable/illustration2" />-->

        </LinearLayout>

        <LinearLayout
            android:id="@+id/smp_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/smp_txt"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/we_ve_emailed_a_link_to"
                android:textSize="15sp" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="10dp"
                android:textAlignment="center"
                android:background="@drawable/radius_gray"
                android:hint="mdradwanhossain21@gmail.com"
                android:inputType="textPassword"
                android:focusable="false"
                android:paddingStart="20dp"
                android:paddingEnd="10dp"
                android:text="" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/click_on_the_link_to_approve_this_device"
                android:textSize="15sp" />

            <Button
                android:id="@+id/resend_email_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/radius_btn_bg"
                android:minHeight="48dp"
                android:text="@string/email_link_again"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/text_link_btn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_margin="20dp"
                android:background="@drawable/radius_transparent_btn"
                android:minHeight="48dp"
                android:text="@string/text_link"
                android:textAllCaps="false"
                android:textColor="@color/purple_200" />

        </LinearLayout>

        <TextView
            android:id="@+id/smp_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/activate_btn"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="0dp"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:text="@string/or_activate_using_your_account_details"
            android:textSize="15sp" />

        <Button
            android:id="@+id/activate_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_above="@+id/stepper02"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/radius_transparent_btn"
            android:minHeight="48dp"
            android:text="@string/activate"
            android:textAllCaps="false"
            android:textColor="@color/purple_200" />

        <LinearLayout
            android:id="@+id/stepper02"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="35dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="2dp"
                android:background="@drawable/white_circle" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="2dp"
                android:background="@drawable/blue_circle" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="2dp"
                android:background="@drawable/white_circle" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_margin="2dp"
                android:background="@drawable/white_circle" />


        </LinearLayout>

    </RelativeLayout>


</LinearLayout>