<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_bg"
    android:orientation="vertical"
    tools:context="com.paymentsave.paymentsave.coreapp.activities.gratuity.GratuityCustomActivity">

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/custom_gratuity_back_btn_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="40dp"
        android:backgroundTint="@color/disable_btn_color"
        app:backgroundTint="@color/purple_200"
        android:src="@drawable/ic_arrow_back_24"
        app:elevation="0dp"
        app:fabCustomSize="30dp" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginTop="-10dp"
        android:layout_marginBottom="25dp"
        android:paddingStart="80dp"
        android:paddingEnd="80dp"
        android:src="@drawable/ic_ptsave" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:text="@string/would_you_like_to_leave_a_tip"
        android:textSize="@dimen/text_size_x_medium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal|bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <!--            android:gravity="right|center"-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="1pt"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/gratuity_ed_enter_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:ems="10"
                    android:focusable="false"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:text="@string/_0_00"
                    android:textColor="@android:color/black"
                    android:textSize="20pt" />

                <TextView
                    android:id="@+id/gratuity_invalid_amount_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/please_enter_a_valid_amount"
                    android:textColor="@color/red"
                    android:visibility="gone" />

            </LinearLayout>


            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="1pt"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnOne"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:textColor="@color/text_color"
                        android:text="@string/one"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/btnTwo"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/two"
                        android:textColor="@color/text_color"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/btnThree"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/three"
                        android:textColor="@color/text_color"
                        android:textSize="22sp" />

                </TableRow>

            </TableLayout>

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="1pt"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnFour"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/_4"
                        android:textColor="@color/text_color"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/btnFive"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/_5"
                        android:textColor="@color/text_color"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/btnSix"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/_6"
                        android:textColor="@color/text_color"
                        android:textSize="22sp" />

                </TableRow>

            </TableLayout>

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="1pt"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnSeven"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/_7"
                        android:textColor="@color/text_color"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/btnEight"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:text="@string/_8"
                        android:textColor="@color/text_color"
                        android:textSize="22sp" />

                    <Button
                        android:id="@+id/btnNine"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:text="@string/_9"
                        android:textColor="@color/text_color"
                        android:textSize="22sp" />

                </TableRow>

            </TableLayout>

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="1pt"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnDoubleZero"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/dubleZero"
                        android:textColor="@color/text_color"
                        android:textSize="22sp" />



                    <Button
                        android:id="@+id/btnZero"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/zero"
                        android:textColor="@color/text_color"
                        android:textSize="22sp" />

                    <ImageButton
                        android:id="@+id/btnC"
                        android:layout_width="90dp"
                        android:layout_height="70dp"
                        android:layout_margin="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@drawable/ic_baseline_backspace_24"
                        android:textSize="22sp"
                        tools:ignore="SpeakableTextPresentCheck" />


                </TableRow>

            </TableLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="10dp">

                <Button
                    android:id="@+id/gratuity_custom_submit_btn"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/radius_gray"
                    android:minHeight="50dp"
                    android:text="@string/pay_now"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/custom_gratuity_back_btn_1"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/radius_transparent_btn"
                    android:minHeight="50dp"
                    android:text="@string/go_back"
                    android:visibility="gone"
                    android:textColor="@color/purple_200" />
            </LinearLayout>

        </LinearLayout>


    </LinearLayout>

</LinearLayout>