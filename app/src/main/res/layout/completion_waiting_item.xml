<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/date_cItem_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today"
        android:padding="10dp"/>

    <RelativeLayout
        android:id="@+id/cancel_main_rl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/radius_gray_btn"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="10dp">

        <ImageView
            android:id="@+id/cancel_payment_icon"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/pound_icon_red"/>

        <!--        <ImageView-->
        <!--            android:id="@+id/cancel_payment_icon"-->
        <!--            android:layout_width="45dp"-->
        <!--            android:layout_height="45dp"-->
        <!--            android:background="@drawable/light_red_circle"-->
        <!--            android:src="@drawable/pound_icon_red"/>-->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:layout_toEndOf="@+id/cancel_payment_icon"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cancel_item_card_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="4646 **** **** **43"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/cancel_item_time_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="06:25pm" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cancel_amt_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:layout_gravity="end"
                android:text="@string/_0_00"
                android:textSize="17sp"
                android:textColor="@color/text_color"
                />
            <TextView
                android:id="@+id/cancel_tnx_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Waiting for processing"
                android:textSize="14sp"
                android:textColor="@color/disable_text_color"/>

        </LinearLayout>




    </RelativeLayout>

</LinearLayout>