<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="0dp"
    android:background="@drawable/bottom_sheet_bg">

        <LinearLayout
            android:id="@+id/mail_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginBottom="10dp"
                android:gravity="center">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/backButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#EEEEEE"
                    android:src="@drawable/ic_arrow_back_24"
                    app:elevation="0dp"
                    app:fabCustomSize="30dp" />

                <TextView
                    android:id="@+id/bottom_sheet_items_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="0dp"
                    android:gravity="center"
                    android:layout_marginBottom="0dp"
                    android:layout_toEndOf="@+id/backButton"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/refund_payment"
                    android:textColor="#444444"
                    android:textSize="15sp" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/refund_amt_et"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="£118.50"
                    android:fontFamily="@font/poppins_medium"
                    android:focusable="false"
                    android:clickable="false"
                    android:textSize="38sp"
                    android:background="@android:color/transparent"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maximum Refund "
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_medium"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="£118.50"
                        android:textSize="14sp"
                        android:textColor="@color/text_color"
                        android:fontFamily="@font/poppins_bold"/>
                </LinearLayout>

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:layout_marginBottom="1pt">

                        <Button
                            android:id="@+id/btnOne"
                            android:layout_width="90dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/button_ripple"
                            android:text="@string/one"
                            android:textSize="22sp" />

                        <Button
                            android:id="@+id/btnTwo"
                            android:layout_width="90dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/button_ripple"
                            android:text="@string/two"
                            android:textSize="22sp"/>

                        <Button
                            android:id="@+id/btnThree"
                            android:layout_width="90dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/button_ripple"
                            android:text="@string/three"
                            android:textSize="22sp"/>

                    </TableRow>

                </TableLayout>

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:layout_marginBottom="1pt">

                        <Button
                            android:id="@+id/btnFour"
                            android:layout_width="90dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/button_ripple"
                            android:text="@string/_4"
                            android:textSize="22sp" />

                        <Button
                            android:id="@+id/btnFive"
                            android:layout_width="90dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/button_ripple"
                            android:text="@string/_5"
                            android:textSize="22sp"/>

                        <Button
                            android:id="@+id/btnSix"
                            android:layout_width="90dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/button_ripple"
                            android:text="@string/_6"
                            android:textSize="22sp"/>

                    </TableRow>

                </TableLayout>

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:layout_marginBottom="1pt">

                        <Button
                            android:id="@+id/btnSeven"
                            android:layout_width="90dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/button_ripple"
                            android:text="@string/_7"
                            android:textSize="22sp"/>

                        <Button
                            android:id="@+id/btnEight"
                            android:layout_width="90dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:background="@drawable/button_ripple"
                            android:text="@string/_8"
                            android:textSize="22sp" />

                        <Button
                            android:id="@+id/btnNine"
                            android:layout_width="90dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:background="@drawable/button_ripple"
                            android:text="@string/_9"
                            android:textSize="22sp" />

                    </TableRow>

                </TableLayout>

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:layout_marginBottom="1pt">

                        <ImageButton
                            android:id="@+id/btnC"
                            android:layout_width="90dp"
                            android:layout_height="70dp"
                            android:layout_margin="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_ripple"
                            android:clickable="true"
                            android:focusable="true"
                            android:src="@drawable/ic_baseline_backspace_24"
                            android:textSize="22sp"
                            tools:ignore="SpeakableTextPresentCheck" />

                        <Button
                            android:id="@+id/btnZero"
                            android:layout_width="90dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/button_ripple"
                            android:text="@string/zero"
                            android:textSize="22sp" />


                        <Button
                            android:id="@+id/btnDoubleZero"
                            android:layout_width="90dp"
                            android:layout_height="70dp"
                            android:layout_weight="1"
                            android:layout_margin="2dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/button_ripple"
                            android:text="@string/dubleZero"
                            android:textSize="22sp"/>

                    </TableRow>

                </TableLayout>

                <Button
                    android:id="@+id/run_refund_btn"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/radius_btn_bg"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    android:textColor="@color/white"
                    android:text="@string/run_refund"/>

            </LinearLayout>



        </LinearLayout>




</LinearLayout>