<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context="com.paymentsave.paymentsave.coreapp.activities.StartPaymentActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ptSaveLogo"
                android:layout_width="wrap_content"
                android:layout_height="70dp"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="40dp"
                android:paddingStart="80dp"
                android:paddingEnd="80dp"
                android:src="@drawable/ic_ptsave" />

            <ImageView
                android:id="@+id/illustration01"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_marginStart="0dp"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="0dp"
                android:src="@drawable/start_payment" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <TextView
        android:id="@+id/text2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/sub_text"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="0dp"
        android:layout_marginTop="150dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="@string/you_re_all_set"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/sub_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/start_taking_payment_btn"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="40dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="@string/experience_secure_and_fast_transactions_anytime"

        android:textSize="15sp" />

    <Button
        android:id="@+id/start_taking_payment_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="80dp"
        android:background="@drawable/radius_btn_bg"
        android:minHeight="48dp"
        android:text="@string/start_taking_payments"
        android:textAllCaps="false"
        android:textColor="@color/white" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="35dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_margin="2dp"
            android:background="@drawable/white_circle" />

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_margin="2dp"
            android:background="@drawable/white_circle" />

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_margin="2dp"
            android:background="@drawable/white_circle" />

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_margin="2dp"
            android:background="@drawable/blue_circle" />
    </LinearLayout>


</RelativeLayout>