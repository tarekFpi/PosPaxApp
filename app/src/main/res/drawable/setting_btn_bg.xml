<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/button_stroke_gray">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners
                android:radius="30dp"/>
            <solid android:color="@color/button_stroke_gray" />
        </shape>
    </item>
    <item>
        <shape>
            <solid
                android:color="@android:color/white"/>
            <corners
                android:radius="30dp"/>
            <stroke
                android:color="#80444444"
                android:width="1dp"/>
        </shape>
    </item>
</ripple>