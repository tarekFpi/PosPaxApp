        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/CustomThemePax"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name="com.paymentsave.paymentsave.coreapp.activities.cashback.CashbackCustomActivity"
            android:exported="true" />
        <activity
            android:name="com.paymentsave.paymentsave.coreapp.activities.CounterPay.CounterPayActivity"
