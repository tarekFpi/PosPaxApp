                android:name="android.app.lib_name"
                android:value="" />
        </activity>
        <activity
            android:name="com.paymentsave.paymentsave.coreapp.activities.onboard.OnboardOneActivity"
            android:exported="true"
            android:launchMode="singleTask" />

        <receiver
            android:name="com.paymentsave.paymentsave.coreapp.receiver.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service android:name="com.paymentsave.paymentsave.coreapp.receiver.Launcher" />
        <service
            android:name="com.paymentsave.paymentsave.coreapp.receiver.LogisticService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service android:name="org.eclipse.paho.android.service.MqttService" />

        <receiver
            android:name="com.paymentsave.paymentsave.coreapp.receiver.PositiveLaunchReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.eft.TRANSACTION_ACK" />
                <action android:name="com.eft.TRANSACTION_RESULT" />
                <action android:name="com.eft.TRANSACTION_STATUS" />
            </intent-filter>
